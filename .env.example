# ── Dashboard environment (build-time) ────────────────────────────────
#
# Vite inlines every VITE_* value into the bundle at build time, so these must
# be set as *build* environment variables — in CI (.github/workflows/pages.yml)
# and in the Cloudflare Pages dashboard. Pages *runtime* variables do nothing
# for a static SPA.
#
# Copy to .env.local for local development.

# Production : https://ccc-backend.pongsinbas.workers.dev
# Development: https://ccc-backend-dev.pongsinbas.workers.dev
#
# If unset, src/lib/store/auth.svelte.ts silently falls back to the PRODUCTION
# worker — always confirm in the Network tab which backend you are hitting.
VITE_API_BASE=https://ccc-backend.pongsinbas.workers.dev

# ── NOT set here ──────────────────────────────────────────────────────
# The Pages Functions in functions/api/ (chat, verify-slip) read CF_ACCOUNT_ID
# and AI_API_KEY. Those are *server-side* bindings configured per-environment
# in the Cloudflare Pages dashboard, and must never carry a VITE_ prefix —
# that would inline the API token into the public client bundle.
# For local Functions testing put them in .dev.vars and use `wrangler pages dev`.
